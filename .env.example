# ==========================================
# Maps Leads & CRM - Environment Variables
# ==========================================

# 1. DATABASE CONFIGURATION
# ------------------------------------------
# Default: Bundled zero-install PGlite database (run `npm run db:dev`)
DATABASE_URL=postgres://127.0.0.1:5432/pglite
POOL_MAX=1
PIPELINE=1

# Production / Remote Postgres (Neon / Supabase / AWS):
# DATABASE_URL=postgres://user:password@ep-sample-pooler.neon.tech/leads?sslmode=require
# (Remove POOL_MAX and PIPELINE when using production Postgres)

# 2. WEB APPLICATION (Next.js 14)
# ------------------------------------------
SESSION_SECRET=dev-secret-replace-with-long-random-string-in-production
ADMIN_EMAIL=team@example.com
ADMIN_PASSWORD=devpassword

# Web calls this to wake/ping the worker after creating a job
WORKER_URL=http://localhost:8080

# 3. SCRAPER & ENRICHMENT WORKER
# ------------------------------------------
POLL_INTERVAL_MS=5000
# Maximum new businesses to collect per keyword x location search
MAX_RESULTS=100
