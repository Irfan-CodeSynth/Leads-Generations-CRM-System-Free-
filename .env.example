# Shared Postgres (Neon in prod; any Postgres 14+ locally)
DATABASE_URL=postgres://user:password@localhost:5432/leads

# Web app
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=team@example.com
ADMIN_PASSWORD=change-me

# Web app calls this to wake/ping the worker after creating a job
WORKER_URL=http://localhost:8080

# Worker
POLL_INTERVAL_MS=5000
# New businesses to collect per keyword x location search (Google caps a feed at ~120).
MAX_RESULTS=100

# ONLY for the bundled PGlite dev server (node scripts/devdb.mjs).
# Leave unset/blank for real Postgres / Neon so the normal pool is used.
# POOL_MAX=1
# PIPELINE=1
